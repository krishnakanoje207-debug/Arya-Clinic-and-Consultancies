# --- Database (Neon Postgres) ---
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth.js (admin login) — REQUIRED in production ---
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Seed owner account (used by npm run db:seed to create the first admin).
ADMIN_EMAIL="drseema.clinic@gmail.com"
ADMIN_PASSWORD="change-me-before-launch"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (Gmail SMTP via Nodemailer) --- [wired by Fable task #5]
GMAIL_USER="drseema.clinic@gmail.com"
GMAIL_APP_PASSWORD=""          # 16-char Google app password (needs 2-step verification)

# --- SMS (textbee.dev Android gateway) --- [wired by Fable task #5]
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""

# --- Cloudinary (admin image uploads: device / Google Drive / Dropbox) ---
# The admin ImageUpload widget needs these TWO public vars. Set up (free):
#   1. Create a Cloudinary account → copy the Cloud name.
#   2. Settings ▸ Upload ▸ add an UNSIGNED upload preset → copy its name.
# Both must be NEXT_PUBLIC_ (used in the browser). Until they are set, image
# fields fall back to a plain paste-a-URL box.
# NOTE the mapping — these two are easy to swap by accident:
#   cloud name = the account slug (dashboard header), preset = the unsigned preset you created.
# Client's real values (verified working 2026-07-06):
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="peyn2yxp"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="aryahomoeopsthy"
# API key/secret are only needed for SIGNED/server-side ops (not used by the
# unsigned browser widget). Safe to leave blank for uploads.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Cron protection (reminders route) ---
CRON_SECRET=""

# --- Optional: Google Drive archival (service account) --- [Fable archival task]
GOOGLE_SERVICE_ACCOUNT_JSON=""
DRIVE_ARCHIVE_FOLDER_ID=""
